{
  "name": "orbiq-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Orbiq Automotive Operations Platform",
  "scripts": {
    "dev": "node scripts/dev-start.mjs",
    "dev:web": "pnpm --filter web dev",
    "recover:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-recover.ps1",
    "build:web": "pnpm --filter web build",
    "prepare:standalone": "node scripts/standalone.mjs",
    "start:standalone": "node scripts/standalone.mjs --start",
    "release:drill": "node scripts/release-drill.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "lint:web": "pnpm --filter web lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  }
}
