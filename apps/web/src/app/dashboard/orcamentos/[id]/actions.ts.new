"use server";

import { revalidatePath } from "next/cache";
import { redirect } from "next/navigation";
import { getCurrentContext } from "../../_lib/current-organization";
import { isUuid } from "../novo/quote-payload";

const text=(fd:FormData,n:string)=>String(fd.get(n)??"").trim();
const parseNumber=(raw:string,fallback:number)=>{const s=raw.trim().replace(/\s/g,"").replace(/\./g,"").replace(",", ".");if(!s)return fallback;const n=Number(s);return Number.isFinite(n)?n:NaN;};
function fail(id:string,msg:string):never{redirect(`/dashboard/orcamentos/${id}?error=${encodeURIComponent(msg)}`);}
async function refreshQuoteTotal(supabase:Awaited<ReturnType<typeof getCurrentContext>>["supabase"],orgId:string,quoteId:string){const [s,i]=await Promise.all([supabase.from("quote_services").select("labor_amount,quantity").eq("organization_id",orgId).eq("quote_id",quoteId),supabase.from("quote_items").select("chosen_amount,quantity").eq("organization_id",orgId).eq("quote_id",quoteId)]);if(s.error)return s.error.message;if(i.error)return i.error.message;const labor=(s.data??[]).reduce((t,r)=>t+Number(r.labor_amount??0)*Number(r.quantity??1),0);const parts=(i.data??[]).reduce((t,r)=>t+Number(r.chosen_amount??0)*Number(r.quantity??1),0);const {error}=await supabase.from("quotes").update({final_amount:Math.round((labor+parts)*100)/100}).eq("id",quoteId).eq("organization_id",orgId);return error?.message??null;}
function paths(id:string){for(const p of ["/dashboard","/dashboard/orcamentos","/dashboard/cotacoes","/dashboard/compras","/dashboard/execucao",`/dashboard/orcamentos/${id}`])revalidatePath(p);}
export async function updateQuoteStatusAction(fd:FormData):Promise<never>{const {supabase,organization}=await getCurrentContext();const id=text(fd,"quote_id");const status=text(fd,"status");if(!id)redirect("/dashboard/orcamentos");const {data,error}=await supabase.from("quotes").update({status}).eq("id",id).eq("organization_id",organization.id).select("id").maybeSingle();if(error||!data)return fail(id,error?.message??"Orçamento não encontrado.");paths(id);redirect(`/dashboard/orcamentos/${id}?ok=Status%20atualizado.`);}
export async function deleteQuoteServiceAction(fd:FormData):Promise<never>{const {supabase,organization}=await getCurrentContext();const id=text(fd,"quote_id");const sid=text(fd,"service_id");if(!id)redirect("/dashboard/orcamentos");if(!isUuid(sid))return fail(id,"Serviço inválido.");const {data,error}=await supabase.from("quote_services").delete().eq("id",sid).eq("quote_id",id).eq("organization_id",organization.id).select("id").maybeSingle();if(error||!data)return fail(id,error?.message??"Serviço não encontrado.");const e=await refreshQuoteTotal(supabase,organization.id,id);if(e)return fail(id,e);paths(id);redirect(`/dashboard/orcamentos/${id}?ok=Serviço%20excluído%20e%20valor%20atualizado.`);}
export async function addQuoteServiceAction(fd:FormData):Promise<never>{const {supabase,organization}=await getCurrentContext();const id=text(fd,"quote_id");const category=text(fd,"category")||"GERAL";const description=text(fd,"description");const unitLabor=parseNumber(text(fd,"labor_amount"),0);const quantity=parseNumber(text(fd,"quantity"),1);const needsPart=fd.get("needs_part")==="on";if(!id)redirect("/dashboard/orcamentos");if(!description)return fail(id,"Informe a descrição do serviço.");if(!Number.isFinite(unitLabor)||unitLabor<0||unitLabor>1000000)return fail(id,"Valor de mão de obra inválido.");if(!Number.isFinite(quantity)||quantity<=0||quantity>100000)return fail(id,"Quantidade do serviço inválida.");const {data:quote,error:qe}=await supabase.from("quotes").select("id").eq("id",id).eq("organization_id",organization.id).maybeSingle();if(qe||!quote)return fail(id,qe?.message??"Orçamento não encontrado.");const {error}=await supabase.from("quote_services").insert({organization_id:organization.id,quote_id:id,category,description,needs_part:needsPart,quantity,labor_amount:Math.round(unitLabor*100)/100});if(error)return fail(id,`Não foi possível adicionar o serviço: ${error.message}`);const te=await refreshQuoteTotal(supabase,organization.id,id);if(te)return fail(id,te);paths(id);redirect(`/dashboard/orcamentos/${id}?ok=Serviço%20adicionado%20e%20valor%20atualizado.`);}
